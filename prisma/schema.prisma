datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model SavedPaper {
  id        Int      @id @default(autoincrement())
  arxivId   String   @unique
  title     String
  authors   String
  summary   String
  pdfUrl    String
  absUrl    String
  published String
  createdAt DateTime @default(now())
  labels    SavedPaperLabel[]
  note      String?
  aiSummary String?
  annotations Annotation[]
}

model Label {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  papers    SavedPaperLabel[]
}

model SavedPaperLabel {
  paperId Int
  labelId Int

  paper   SavedPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  label   Label      @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([paperId, labelId])
}

// A highlight on a passage of a paper's PDF, with an optional note.
// rects are fractions of the page size: [[x, y, w, h], ...] as JSON.
model Annotation {
  id        Int        @id @default(autoincrement())
  paperId   Int
  paper     SavedPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  version   String     @default("")
  page      Int
  rects     String
  quote     String
  note      String     @default("")
  color     String     @default("yellow")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([paperId])
}
