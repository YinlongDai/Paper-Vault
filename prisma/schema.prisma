datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model SavedPaper {
  id        Int      @id @default(autoincrement())
  arxivId   String   @unique
  title     String
  authors   String
  summary   String
  pdfUrl    String
  absUrl    String
  published String
  createdAt DateTime @default(now())
  labels    SavedPaperLabel[]
  note      String?
  aiSummary String?
  annotations Annotation[]
  // Code / project-page links found for the paper: JSON { items: [{ kind, url, source, stars? }], removed: [url] }
  links          String?
  linksCheckedAt DateTime?
  // Reading queue: "unread" | "reading" | "done"; priority 0 = normal, 1 = high
  status   String @default("unread")
  priority Int    @default(0)
  // Where the owner left off in the reader
  lastPage   Int?
  pageCount  Int?
  lastZoom   Float?
  lastReadAt DateTime?
  // Newest arXiv version seen by the version checker, and the one the owner acknowledged
  latestVersion    String?
  versionSeen      String?
  versionCheckedAt DateTime?
}

model Label {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  papers    SavedPaperLabel[]
}

model SavedPaperLabel {
  paperId Int
  labelId Int

  paper   SavedPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  label   Label      @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([paperId, labelId])
}

// A highlight on a passage of a paper's PDF, with an optional note.
// rects are fractions of the page size: [[x, y, w, h], ...] as JSON.
model Annotation {
  id        Int        @id @default(autoincrement())
  paperId   Int
  paper     SavedPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  version   String     @default("")
  page      Int
  rects     String
  quote     String
  note      String     @default("")
  color     String     @default("yellow")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([paperId])
}

// A search the owner follows; the home page shows its newest arXiv papers.
model SavedSearch {
  id         Int       @id @default(autoincrement())
  query      String
  field      String    @default("smart")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@unique([query, field])
}
